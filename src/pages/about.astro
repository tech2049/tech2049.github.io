---
import '../styles/global.css';
---

<html lang="fa" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>درباره من | Tech2049</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@100..900&display=swap" rel="stylesheet">
    <link rel="icon" type="image/png" href="/favicon.png" />
  </head>
  <body>
    <header class="glass-capsule">
      <div class="logo"><a href="/">Tech2049</a></div>
      <nav class="desktop-nav">
        <a href="/about">درباره</a>
      </nav>
      <button class="hamburger" id="menu-btn" aria-label="منو">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </header>

    <div class="mobile-menu glass-panel" id="mobile-menu">
      <a href="/about">درباره</a>
    </div>

    <main class="about-container">
      <div class="glass-panel about-content">
        <div class="profile-header">
          <div class="profile-avatar">S</div>
          <h1>درباره من</h1>
        </div>
        
        <hr class="glass-divider" />
        
        <section class="bio-section">
          <h2>من کی هستم؟</h2>
          <p>
            سلام، من سامان راستین هستم؛ نویسنده و وبلاگ‌نویس در حوزه‌های شبکه، امنیت و نرم‌افزار. از سال ۱۴۰۴ فعالیت خود را آغاز کردم. هدف من از این مسیر، ایجاد تغییرات مثبت، ابتدا در رشد فردی خودم و سپس در جامعه‌ای است که در آن زندگی می‌کنم. بسیار خوشحال می‌شوم اگر نظر یا حمایتی دارید، با من به اشتراک بگذارید.
          </p>
        </section>

        <section class="contact-section">
          <h2>راه‌های ارتباطی</h2>
          <div class="contact-grid">
            <a href="mailto:saman.rastin@proton.me" class="contact-item glass-card">
              <span class="icon">📧</span>
              <h3>ایمیل</h3>
              <p>جهت مکاتبات رسمی و ارتباط مستقیم</p>
            </a>
            <a href="#" class="contact-item glass-card">
              <span class="icon">📢</span>
              <h3>تلگرام</h3>
              <p>عضویت در کانال رسمی Tech2049</p>
            </a>
          </div>
        </section>
      </div>
    </main>

    <script>
      const menuBtn = document.getElementById('menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');

      menuBtn?.addEventListener('click', () => {
        mobileMenu?.classList.toggle('active');
      });
    </script>
  </body>
</html>